# tooling / build output
.theos/
artifacts/
*.dylib
*.deb

# e5 TLS probe tool: the armv7 binary is built from e5/e5.m, not committed
e5/e5

# copyrighted app binaries and generated metadata (never redistribute)
*.bin
objc-meta.txt

# capture artifacts and secrets
imdb-capture/.mitm/
imdb-capture/bodies/
imdb-capture/traffic.jsonl
imdb-capture/traffic.log
*.log

# crash reports contain device identifiers
crash*.plist
latest-crash.plist

.freebuff/
.DS_Store

# shim runtime logs and on-device probe captures
# (every line carries request URLs and, for the probe, the device container path
#  and the app's device identifier -- keep them out of the repo)
shim/*.jsonl

# pulled device probe log
imdb-tweak/imdb-probe.jsonl

# shim TLS material (self-signed, generated locally)
shim/certs/

# on-device probe logs pulled into the repo by hand
logs/

# API keys live on the device only (never commit them)
keys.plist
**/keys.plist
*.key
