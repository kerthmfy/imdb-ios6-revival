<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.imdbrevival.watch</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/sh</string>
		<string>/var/root/imdb-watch.sh</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<!-- The watcher is a loop that never exits; KeepAlive restarts it if it
	     ever does, so a single kill cannot leave the app permanently
	     uninjected. ThrottleInterval keeps a crash loop from spinning. -->
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>10</integer>
	<key>StandardOutPath</key>
	<string>/var/mobile/Library/Logs/imdbwatch.out</string>
	<key>StandardErrorPath</key>
	<string>/var/mobile/Library/Logs/imdbwatch.out</string>
</dict>
</plist>
